{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubase Web Remote",
  "version": "0.1.0",
  "identifier": "dev.j0x.cubasewebremote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cubase Web Remote — Host Server",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Japanese",
          "English"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "ja-JP"
      }
    }
  }
}
